{
  "name": "nibble-desktop",
  "version": "0.1.0",
  "private": true,
  "description": "Fumufumu on your desktop: a small always-on-top window with your pet, and your list one click away.",
  "author": "Lauren",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win --publish never",
    "release": "electron-builder --win --publish always"
  },
  "devDependencies": {
    "electron": "^44.7.0",
    "electron-builder": "^26.0.0"
  },
  "build": {
    "appId": "com.laurmoe.nibble",
    "productName": "Fumufumu",
    "files": [
      "main.js",
      "preload.js",
      "place.js",
      "windows.js",
      "channel.js",
      "keys.js",
      "panel-main.js",
      "panel-preload.js",
      "panel.html",
      "panel-ui.js",
      "build/icon.png",
      "package.json"
    ],
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "win": {
      "target": "nsis",
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "runAfterFinish": true,
      "deleteAppDataOnUninstall": false,
      "artifactName": "Fumufumu-Setup-${version}.${ext}"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "laurmoe7",
        "repo": "pet-shopper",
        "releaseType": "release"
      }
    ],
    "electronLanguages": [
      "en-US",
      "nl"
    ],
    "compression": "maximum"
  },
  "dependencies": {
    "electron-updater": "^6.8.9",
    "koffi": "^3.3.2"
  }
}
