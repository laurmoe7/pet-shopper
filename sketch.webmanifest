{
  "name": "Nibble Sketchpad",
  "short_name": "Sketchpad",
  "description": "Draw skins, hats, toys, backgrounds and furniture over Nibble's pets.",
  "id": "./sketch.html",
  "start_url": "./sketch.html",
  "scope": "./",
  "display": "standalone",
  "background_color": "#fdf1f3",
